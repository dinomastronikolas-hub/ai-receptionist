# --- Required -----------------------------------------------------------------
# Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The *publishable* key (sb_publishable_…) or the legacy "anon" key. Safe for browsers.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public URL of the app — used for invite links and auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: Google sign-in (enable the provider in Supabase first) ---------
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# --- Optional: reminder push notifications ----------------------------------
# Generate with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Server-only secret key (sb_secret_…) or legacy service_role key. NEVER expose to the browser.
SUPABASE_SECRET_KEY=
# Random string; the scheduler sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
